[Desktop Entry]
Name=Toggle Hidden Files View
Type=Service
MimeType=inode/directory;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Priority=TopLevel
Icon=view-visible
Actions=ToggleHiddenFilesView;
# TryExec=qdbus6 # no longer used, as some distros use unusual names
# TODO What is openSUSE using? -> 'qdbus6'. Fedora uses 'qdbus-qt6'
# TODO Switch to a more generic command? (such as dbus-send)
# TODO Check, if former and later missing action is back again?
# TODO Rename to toggle-*?

[Desktop Action ToggleHiddenFilesView]
Name=Toggle Hidden Files View	Ctrl-H
Name[de]=Versteckte Dateien anzeigen	Strg-H
Name[nl]=Verborgen bestanden tonen	Ctrl+H
Icon=view-visible
Exec=bash -c 'QDBUS=$(type -p qdbus qdbus6 qdbus5 qdbus-qt6 qdbus-qt5 | head -1); for sname in $( $QDBUS "org.kde.dolphin-*" ) ; do isactive=false ; isactive=$( $QDBUS "$sname" "/dolphin/Dolphin_1" "org.qtproject.Qt.QWidget.isActiveWindow" ) ; $isactive && $QDBUS "$sname" "/dolphin/Dolphin_1/actions/show_hidden_files" "org.qtproject.Qt.QAction.trigger" ; done'
